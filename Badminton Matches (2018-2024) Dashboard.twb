              <calculation class='tableau' formula='(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;            THEN 1&#10;            ELSE 0&#10;            END&#10;        )&#10;    } = 1&#10;)&#10;&#10;AND&#10;&#10;(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;            THEN 1&#10;            ELSE 0&#10;            END&#10;        )&#10;    } = 1&#10;)&#10;&#10;AND&#10;&#10;(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;            THEN [Team]&#10;            END&#10;        )&#10;    }&#10;    !=&#10;&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;            THEN [Team]&#10;            END&#10;        )&#10;    }&#10;)' />
