      <aliases enabled='yes' />
      <column caption='Win' datatype='integer' name='[Calculation_0254993871036420]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Result] = &quot;Win&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Matches Played' datatype='integer' name='[Calculation_0254993871491077]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    STR([Match ID])&#10;    + &quot;-&quot;&#10;    + STR([Player ID])&#10;)' />
      </column>
      <column caption='Win Rate' datatype='real' default-format='p0%' name='[Calculation_0254993871609862]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0254993871036420]) / [Calculation_0254993871491077]' />
      </column>
      <column caption='Top 10 Players' datatype='boolean' name='[Calculation_0254994062651424]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#10;    [Calculation_0254993871609862],&#10;    &apos;desc&apos;&#10;) &lt;= 10'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country Flag Image' datatype='string' name='[Calculation_0254994069909538]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Nationality]&#10;WHEN &quot;ALG&quot; THEN &quot;🇩🇿&quot;&#10;WHEN &quot;AUS&quot; THEN &quot;🇦🇺&quot;&#10;WHEN &quot;AUT&quot; THEN &quot;🇦🇹&quot;&#10;WHEN &quot;AZE&quot; THEN &quot;🇦🇿&quot;&#10;WHEN &quot;BEL&quot; THEN &quot;🇧🇪&quot;&#10;WHEN &quot;BLR&quot; THEN &quot;🇧🇾&quot;&#10;WHEN &quot;BRA&quot; THEN &quot;🇧🇷&quot;&#10;WHEN &quot;BRN&quot; THEN &quot;🇧🇳&quot;&#10;WHEN &quot;BUL&quot; THEN &quot;🇧🇬&quot;&#10;WHEN &quot;CAN&quot; THEN &quot;🇨🇦&quot;&#10;WHEN &quot;CHN&quot; THEN &quot;🇨🇳&quot;&#10;WHEN &quot;CRO&quot; THEN &quot;🇭🇷&quot;&#10;WHEN &quot;CZE&quot; THEN &quot;🇨🇿&quot;&#10;WHEN &quot;DEN&quot; THEN &quot;🇩🇰&quot;&#10;WHEN &quot;DOM&quot; THEN &quot;🇩🇴&quot;&#10;WHEN &quot;EGY&quot; THEN &quot;🇪🇬&quot;&#10;WHEN &quot;ENG&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;ESA&quot; THEN &quot;🇸🇻&quot;&#10;WHEN &quot;ESP&quot; THEN &quot;🇪🇸&quot;&#10;WHEN &quot;EST&quot; THEN &quot;🇪🇪&quot;&#10;WHEN &quot;FIN&quot; THEN &quot;🇫🇮&quot;&#10;WHEN &quot;FRA&quot; THEN &quot;🇫🇷&quot;&#10;WHEN &quot;GER&quot; THEN &quot;🇩🇪&quot;&#10;WHEN &quot;GUA&quot; THEN &quot;🇬🇹&quot;&#10;WHEN &quot;HKG&quot; THEN &quot;🇭🇰&quot;&#10;WHEN &quot;HUN&quot; THEN &quot;🇭🇺&quot;&#10;WHEN &quot;INA&quot; THEN &quot;🇮🇩&quot;&#10;WHEN &quot;IND&quot; THEN &quot;🇮🇳&quot;&#10;WHEN &quot;IRI&quot; THEN &quot;🇮🇷&quot;&#10;WHEN &quot;IRL&quot; THEN &quot;🇮🇪&quot;&#10;WHEN &quot;ISL&quot; THEN &quot;🇮🇸&quot;&#10;WHEN &quot;ISR&quot; THEN &quot;🇮🇱&quot;&#10;WHEN &quot;ITA&quot; THEN &quot;🇮🇹&quot;&#10;WHEN &quot;JPN&quot; THEN &quot;🇯🇵&quot;&#10;WHEN &quot;KAZ&quot; THEN &quot;🇰🇿&quot;&#10;WHEN &quot;KOR&quot; THEN &quot;🇰🇷&quot;&#10;WHEN &quot;LAT&quot; THEN &quot;🇱🇻&quot;&#10;WHEN &quot;LUX&quot; THEN &quot;🇱🇺&quot;&#10;WHEN &quot;MAC&quot; THEN &quot;🇲🇴&quot;&#10;WHEN &quot;MAR&quot; THEN &quot;🇲🇦&quot;&#10;WHEN &quot;MAS&quot; THEN &quot;🇲🇾&quot;&#10;WHEN &quot;MDV&quot; THEN &quot;🇲🇻&quot;&#10;WHEN &quot;MEX&quot; THEN &quot;🇲🇽&quot;&#10;WHEN &quot;MRI&quot; THEN &quot;🇲🇺&quot;&#10;WHEN &quot;MYA&quot; THEN &quot;🇲🇲&quot;&#10;WHEN &quot;NED&quot; THEN &quot;🇳🇱&quot;&#10;WHEN &quot;NEP&quot; THEN &quot;🇳🇵&quot;&#10;WHEN &quot;NGR&quot; THEN &quot;🇳🇬&quot;&#10;WHEN &quot;NOR&quot; THEN &quot;🇳🇴&quot;&#10;WHEN &quot;NZL&quot; THEN &quot;🇳🇿&quot;&#10;WHEN &quot;PER&quot; THEN &quot;🇵🇪&quot;&#10;WHEN &quot;PHI&quot; THEN &quot;🇵🇭&quot;&#10;WHEN &quot;POL&quot; THEN &quot;🇵🇱&quot;&#10;WHEN &quot;RSA&quot; THEN &quot;🇿🇦&quot;&#10;WHEN &quot;RUS&quot; THEN &quot;🇷🇺&quot;&#10;WHEN &quot;SCO&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;SGP&quot; THEN &quot;🇸🇬&quot;&#10;WHEN &quot;SLO&quot; THEN &quot;🇸🇮&quot;&#10;WHEN &quot;SRB&quot; THEN &quot;🇷🇸&quot;&#10;WHEN &quot;SRI&quot; THEN &quot;🇱🇰&quot;&#10;WHEN &quot;SUI&quot; THEN &quot;🇨🇭&quot;&#10;WHEN &quot;SVK&quot; THEN &quot;🇸🇰&quot;&#10;WHEN &quot;SWE&quot; THEN &quot;🇸🇪&quot;&#10;WHEN &quot;THA&quot; THEN &quot;🇹🇭&quot;&#10;WHEN &quot;TPE&quot; THEN &quot;🇹🇼&quot;&#10;WHEN &quot;TUR&quot; THEN &quot;🇹🇷&quot;&#10;WHEN &quot;UAE&quot; THEN &quot;🇦🇪&quot;&#10;WHEN &quot;UGA&quot; THEN &quot;🇺🇬&quot;&#10;WHEN &quot;UKR&quot; THEN &quot;🇺🇦&quot;&#10;WHEN &quot;USA&quot; THEN &quot;🇺🇸&quot;&#10;WHEN &quot;VIE&quot; THEN &quot;🇻🇳&quot;&#10;WHEN &quot;WAL&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;ZAM&quot; THEN &quot;🇿🇲&quot;&#10;END' />
      </column>
      <column caption='Winning Team' datatype='string' hidden='true' name='[Calculation_0254994085281829]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Match Winner] = [Team 1 Name(s)] THEN&#10;    &quot;Team 1&quot;&#10;ELSEIF [Match Winner] = [Team 2 Name(s)] THEN&#10;    &quot;Team 2&quot;&#10;END' />
      </column>
      <column caption='Upset?' datatype='boolean' name='[Calculation_0254994086465574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Rank Gap] &gt; 0' />
      </column>
      <column caption='Upset Details' datatype='string' hidden='true' name='[Calculation_0254994089488424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Rank #&quot; &#10;+ STR(INT([Winner Rank]))&#10;+ &quot; vs Rank #&quot;&#10;+ STR(INT([Loser Rank]))' />
      </column>
      <column caption='Match Loser' datatype='string' name='[Calculation_0254994221371448]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Match Winner] = [Team 1 Name(s)] THEN&#10;    [Team 2 Name(s)]&#10;ELSEIF [Match Winner] = [Team 2 Name(s)] THEN&#10;    [Team 1 Name(s)]&#10;END' />
      </column>
      <column caption='H2H Match' datatype='boolean' name='[Calculation_0254994482982983]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;            THEN 1&#10;            ELSE 0&#10;            END&#10;        )&#10;    } = 1&#10;)&#10;&#10;AND&#10;&#10;(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;            THEN 1&#10;            ELSE 0&#10;            END&#10;        )&#10;    } = 1&#10;)&#10;&#10;AND&#10;&#10;(&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;            THEN [Team]&#10;            END&#10;        )&#10;    }&#10;    !=&#10;&#10;    { FIXED [Match ID] :&#10;        MAX(&#10;            IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;            THEN [Team]&#10;            END&#10;        )&#10;    }&#10;)' />
      </column>
      <column caption='H2H Opponents' datatype='boolean' hidden='true' name='[Calculation_0254994489565256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Match ID] :&#10;    MAX(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        THEN [Team]&#10;        END&#10;    )&#10;}&#10;!=&#10;&#10;{ FIXED [Match ID] :&#10;    MAX(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;        THEN [Team]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='H2H Player 1 Wins KPI' datatype='integer' name='[Calculation_0254994489925705]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_0254994482982983] = TRUE&#10;    AND [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;    AND [Result] = &quot;Win&quot;&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='H2H Player 2 Wins KPI' datatype='integer' name='[Calculation_0254994489978954]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_0254994482982983] = TRUE&#10;    AND [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;    AND [Result] = &quot;Win&quot;&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='H2H Winner' datatype='string' name='[Calculation_0254994490425422]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Match Winner] = [Parameters].[Parameter 0254994482085952] THEN&#10;    &quot;Player 1&quot;&#10;&#10;ELSEIF [Match Winner] = [Parameters].[Parameter 0254994482352194] THEN&#10;    &quot;Player 2&quot;&#10;&#10;END' />
      </column>
      <column caption='Selected Player 1 Display' datatype='string' name='[Calculation_0254994571718738]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0254994482085952]' />
      </column>
      <column caption='Selected Player 2 Display' datatype='string' name='[Calculation_0254994572402771]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 0254994482352194]' />
      </column>
      <column caption='Player 1 Win Rate' datatype='real' default-format='p0%' name='[Calculation_2739134944768002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;    AND [Result] = &quot;Win&quot;&#10;    THEN [Match ID]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='Player 2 Win Rate' datatype='real' default-format='p0%' name='[Calculation_2739134944993283]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;    AND [Result] = &quot;Win&quot;&#10;    THEN [Match ID]&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='H2H Total Matches' datatype='integer' hidden='true' name='[Calculation_2739135098146822]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Calculation_0254994482982983] = TRUE&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='Player 1 H2H Country' datatype='string' name='[Calculation_2739135110082569]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482085952] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        THEN [Nationality]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 2 H2H Country' datatype='string' name='[Calculation_2739135110303756]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482352194] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;        THEN [Nationality]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='H2H Player 1 Points' datatype='integer' name='[Calculation_2739135118925839]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Match ID] :&#10;    MAX(&#10;        IF [Calculation_0254994482982983] = TRUE&#10;        AND [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        THEN&#10;            IF [Team] = &quot;Team 1&quot;&#10;            THEN [Total Points Team 1]&#10;            ELSE [Total Points Team 2]&#10;            END&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='H2H Player 2 Points' datatype='integer' name='[Calculation_2739135119577104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Match ID] :&#10;    MAX(&#10;        IF [Calculation_0254994482982983] = TRUE&#10;        AND [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;        THEN&#10;            IF [Team] = &quot;Team 1&quot;&#10;            THEN [Total Points Team 1]&#10;            ELSE [Total Points Team 2]&#10;            END&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 1 Total Matches' datatype='integer' name='[Calculation_2739135125995538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='Player 2 Total Matches' datatype='integer' name='[Calculation_2739135126089747]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;    THEN [Match ID]&#10;    END&#10;)' />
      </column>
      <column caption='Player 1 Toughest Opponent Rank' datatype='integer' hidden='true' name='[Calculation_2739135126548500]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482085952] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        THEN&#10;            IF [Result] = &quot;Win&quot;&#10;            THEN [Loser Rank]&#10;            ELSE [Winner Rank]&#10;            END&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 2 Toughest Opponent Rank' datatype='integer' hidden='true' name='[Calculation_2739135130185749]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482352194] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;        THEN&#10;            IF [Result] = &quot;Win&quot;&#10;            THEN [Loser Rank]&#10;            ELSE [Winner Rank]&#10;            END&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 1 Toughest Opponent Name' datatype='string' hidden='true' name='[Calculation_2739135130308630]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482085952] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        AND&#10;        (&#10;            IF [Result] = &quot;Win&quot;&#10;            THEN [Loser Rank]&#10;            ELSE [Winner Rank]&#10;            END&#10;        ) = [Calculation_2739135126548500]&#10;        THEN&#10;            IF [Team] = &quot;Team 1&quot;&#10;            THEN [Team 2 Name(s)]&#10;            ELSE [Team 1 Name(s)]&#10;            END&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 1 Rank' datatype='integer' name='[Calculation_2739135131553816]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Ranking ID] :&#10;    MAX(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482085952]&#10;        THEN [Rank]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Player 2 Rank' datatype='integer' name='[Calculation_2739135131602969]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(&#10;    IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;    THEN [Rank]&#10;    END&#10;)' />
      </column>
      <column caption='Player 1 Country Image' datatype='string' hidden='true' name='[Calculation_2739135148666906]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_2739135110082569]&#10;&#10;WHEN &quot;CHN&quot; THEN &quot;🇨🇳&quot;&#10;WHEN &quot;MAS&quot; THEN &quot;🇲🇾&quot;&#10;WHEN &quot;INA&quot; THEN &quot;🇮🇩&quot;&#10;WHEN &quot;DEN&quot; THEN &quot;🇩🇰&quot;&#10;WHEN &quot;JPN&quot; THEN &quot;🇯🇵&quot;&#10;WHEN &quot;THA&quot; THEN &quot;🇹🇭&quot;&#10;WHEN &quot;IND&quot; THEN &quot;🇮🇳&quot;&#10;WHEN &quot;FRA&quot; THEN &quot;🇫🇷&quot;&#10;WHEN &quot;ENG&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;KOR&quot; THEN &quot;🇰🇷&quot;&#10;WHEN &quot;NED&quot; THEN &quot;🇳🇱&quot;&#10;WHEN &quot;TPE&quot; THEN &quot;🇹🇼&quot;&#10;WHEN &quot;SUI&quot; THEN &quot;🇨🇭&quot;&#10;WHEN &quot;CZE&quot; THEN &quot;🇨🇿&quot;&#10;WHEN &quot;GER&quot; THEN &quot;🇩🇪&quot;&#10;WHEN &quot;ESP&quot; THEN &quot;🇪🇸&quot;&#10;WHEN &quot;CAN&quot; THEN &quot;🇨🇦&quot;&#10;WHEN &quot;AUS&quot; THEN &quot;🇦🇺&quot;&#10;WHEN &quot;SGP&quot; THEN &quot;🇸🇬&quot;&#10;WHEN &quot;HKG&quot; THEN &quot;🇭🇰&quot;&#10;WHEN &quot;IRL&quot; THEN &quot;🇮🇪&quot;&#10;WHEN &quot;SCO&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;WAL&quot; THEN &quot;🏴&quot;&#10;WHEN &quot;NZL&quot; THEN &quot;🇳🇿&quot;&#10;WHEN &quot;USA&quot; THEN &quot;🇺🇸&quot;&#10;WHEN &quot;RUS&quot; THEN &quot;🇷🇺&quot;&#10;WHEN &quot;UKR&quot; THEN &quot;🇺🇦&quot;&#10;WHEN &quot;POL&quot; THEN &quot;🇵🇱&quot;&#10;WHEN &quot;SWE&quot; THEN &quot;🇸🇪&quot;&#10;WHEN &quot;NOR&quot; THEN &quot;🇳🇴&quot;&#10;WHEN &quot;FIN&quot; THEN &quot;🇫🇮&quot;&#10;WHEN &quot;EGY&quot; THEN &quot;🇪🇬&quot;&#10;WHEN &quot;BUL&quot; THEN &quot;🇧🇬&quot;&#10;WHEN &quot;VIE&quot; THEN &quot;🇻🇳&quot;&#10;WHEN &quot;TUR&quot; THEN &quot;🇹🇷&quot;&#10;WHEN &quot;SVK&quot; THEN &quot;🇸🇰&quot;&#10;WHEN &quot;NGR&quot; THEN &quot;🇳🇬&quot;&#10;WHEN &quot;MYA&quot; THEN &quot;🇲🇲&quot;&#10;WHEN &quot;ISR&quot; THEN &quot;🇮🇱&quot;&#10;WHEN &quot;EST&quot; THEN &quot;🇪🇪&quot;&#10;WHEN &quot;BRA&quot; THEN &quot;🇧🇷&quot;&#10;WHEN &quot;BEL&quot; THEN &quot;🇧🇪&quot;&#10;WHEN &quot;ALG&quot; THEN &quot;🇩🇿&quot;&#10;&#10;END' />
      </column>
      <column caption='Player 2 Country Image' datatype='string' hidden='true' name='[Calculation_3234808738398208]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Parameters].[Parameter 0254994482352194] :&#10;    MIN(&#10;        IF [Player Name] = [Parameters].[Parameter 0254994482352194]&#10;        THEN [Calculation_0254994069909538]&#10;        END&#10;    )&#10;}' />
      </column>
      <column caption='Total Matches' datatype='integer' name='[Calculation_6644805566140416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Match ID])' />
