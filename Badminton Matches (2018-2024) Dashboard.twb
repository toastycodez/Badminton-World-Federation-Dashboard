      <column caption='Match Player Records' datatype='integer' hidden='true' name='[Calculation_6644805567762434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    STR([Match ID])&#10;    + &quot;-&quot;&#10;    + STR([Player ID])&#10;)' />
