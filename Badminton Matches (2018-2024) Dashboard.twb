            <run fontalignment='1' fontcolor='#666666' fontname='Tableau Semibold' fontsize='9'>Top Players By Win Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='badmintondb' name='federated.1hmkfuh1h4gl6e19gdef51o50sjg' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Discipline Parameter' datatype='string' name='[Parameter 6644805678833682]' param-domain-type='list' role='measure' type='nominal' value='&quot;MS&quot;'>
              <calculation class='tableau' formula='&quot;MS&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1hmkfuh1h4gl6e19gdef51o50sjg'>
            <column caption='Win' datatype='integer' name='[Calculation_0254993871036420]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Result] = &quot;Win&quot; THEN 1 ELSE 0 END' />
            </column>
            <column caption='Matches Played' datatype='integer' name='[Calculation_0254993871491077]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#10;    STR([Match ID])&#10;    + &quot;-&quot;&#10;    + STR([Player ID])&#10;)' />
            </column>
            <column caption='Win Rate' datatype='real' default-format='p0%' name='[Calculation_0254993871609862]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0254993871036420]) / [Calculation_0254993871491077]' />
            </column>
            <column caption='Int(1)' datatype='integer' name='[Calculation_0254994035023895]' role='measure' type='quantitative' user:unnamed='Sheet 7'>
              <calculation class='tableau' formula='Int(1)' />
            </column>
            <column caption='int(0)' datatype='integer' name='[Calculation_0254994035363866]' role='measure' type='quantitative' user:unnamed='Sheet 7'>
              <calculation class='tableau' formula='int(0)' />
            </column>
            <column caption='Top 10 Players' datatype='boolean' name='[Calculation_0254994062651424]' role='measure' type='nominal'>
              <calculation class='tableau' formula='RANK_UNIQUE(&#10;    [Calculation_0254993871609862],&#10;    &apos;desc&apos;&#10;) &lt;= 10'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Discipline - Select?' datatype='boolean' name='[Calculation_6644805679087635]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Discipline], [Parameters].[Parameter 6644805678833682]) THEN TRUE ELSE FALSE END' />
            </column>
            <column datatype='string' name='[Discipline]' role='dimension' type='nominal' />
            <column aggregation='CountD' datatype='string' default-role='measure' default-type='quantitative' name='[Match ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Player ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Player Name]' role='dimension' type='nominal' />
            <column datatype='string' name='[Result]' role='dimension' type='nominal' />
            <column caption='Win Rate (copy)' datatype='real' name='[Win Rate (copy)_0254994037616669]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0254993871036420]) / [Calculation_0254993871491077]' />
            </column>
            <column-instance column='[Calculation_6644805679087635]' derivation='None' name='[none:Calculation_6644805679087635:nk]' pivot='key' type='nominal' />
            <column-instance column='[Discipline]' derivation='None' name='[none:Discipline:nk]' pivot='key' type='nominal' />
            <column-instance column='[Player Name]' derivation='None' name='[none:Player Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0254994035023895]' derivation='Sum' name='[sum:Calculation_0254994035023895:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0254994035363866]' derivation='Sum' name='[sum:Calculation_0254994035363866:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0254993871609862]' derivation='User' name='[usr:Calculation_0254993871609862:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0254994062651424]' derivation='User' name='[usr:Calculation_0254994062651424:nk:1]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Win Rate (copy)_0254994037616669]' derivation='User' name='[usr:Win Rate (copy)_0254994037616669:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1hmkfuh1h4gl6e19gdef51o50sjg].[:Measure Names]'>
